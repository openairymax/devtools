# ===========================================================================
# Airymax DevTools 顶层仓 .gitignore
# 策略：非必要不追踪
# ---------------------------------------------------------------------------
# 默认忽略所有
# ---------------------------------------------------------------------------
*
# ---------------------------------------------------------------------------
# 顶层仓必要文件（白名单）
# ---------------------------------------------------------------------------
!.gitignore
!LICENSE
!NOTICE
!README.md
!README_zh.md
!.clang-format
!.clang-tidy
!.clangd
!.git-blame-ignore-revs
!.pre-commit-config.yaml
!pyproject.toml
!vcpkg.json
!deploy/
!deploy/**
!scripts/
!scripts/**
!tests/
!tests/**
# ---------------------------------------------------------------------------
# 测试运行时产物（黑名单，覆盖白名单 tests/**）
# ---------------------------------------------------------------------------
tests/**/memory/data/rec-*.bin
tests/**/heapstore/logs/*.log
tests/**/*.log
tests/**/*.tmp

# ===== 通用兜底（2026-08 统一更新） =====
# 误放的大型运行时目录（JDK 等）与运行时产物
oracleJdk-*/
jdk-*/
*.log
*.sock
/run/
/logs/
