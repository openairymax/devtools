#!/usr/bin/env bash
# shellcheck shell=bash
# Copyright (c) 2026 SPHARX Ltd. All Rights Reserved.
# AgentRT 本地组件策略 CLI
# 职责：自托管组件（llama.cpp）与模型工件（gguf）的安装/状态/卸载编排
# ——pin 解析、变体回退链、来源序列组装、落位布局与注册表管理。
# 机制与策略分离：取件、续传与双校验机制由 lib/fetch.sh 提供，
# 本文件不感知任何网络与哈希实现细节；pin 数据独立于 templates/。
# 用法：airy-local install|status|remove [--variant cpu|sycl] [--pin <file>]

set -euo pipefail

AIRY_LOCAL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=../lib/common.sh
source "${AIRY_LOCAL_DIR}/../lib/common.sh"
# shellcheck source=../lib/fetch.sh
source "${AIRY_LOCAL_DIR}/../lib/fetch.sh"

AIRY_LOCAL_COMPONENT="llamacpp"

###############################################################################
# 路径解析
###############################################################################

airy_local_home() {
    echo "${AIRY_HOME:-${HOME}/.airymaxrt}"
}

airy_local_component_dir() {
    echo "$(airy_local_home)/local/${AIRY_LOCAL_COMPONENT}"
}

airy_local_registry_file() {
    echo "$(airy_local_component_dir)/installed.env"
}

airy_local_pin_file() {
    if [[ -n "${_AIRY_LOCAL_PIN_OVERRIDE:-}" ]]; then
        echo "$_AIRY_LOCAL_PIN_OVERRIDE"
    else
        echo "${AIRY_LOCAL_PIN:-${AIRY_LOCAL_DIR}/../templates/llama-pin.list}"
    fi
}

airy_local_models_dir() {
    echo "$(airy_local_home)/local/models"
}

airy_local_model_registry() {
    echo "$(airy_local_models_dir)/installed.env"
}

airy_local_model_pin_file() {
    if [[ -n "${_AIRY_LOCAL_MODEL_PIN_OVERRIDE:-}" ]]; then
        echo "$_AIRY_LOCAL_MODEL_PIN_OVERRIDE"
    else
        echo "${AIRY_LOCAL_MODEL_PIN:-${AIRY_LOCAL_DIR}/../templates/llama-models.list}"
    fi
}

airy_local_managed_file() {
    echo "$(airy_local_home)/config/managed.d/llamacpp.env"
}

###############################################################################
# 托管声明片段（supervisor 侧由 agentrt-bootstrap.sh 通用摄取四键契约）
###############################################################################

# 取一件在位模型的 asset 名（注册表声明顺序首个在位者），无则空
airy_local_model_pick() {
    local registry="$1"
    [[ -f "$registry" ]] || return 0
    local key asset
    while IFS= read -r key; do
        asset="$(airy_config_get "$registry" "$key")"
        if [[ -n "$asset" && -f "$(airy_local_models_dir)/${asset}" ]]; then
            printf '%s\n' "$asset"
            return 0
        fi
    done < <(grep '^model\..*\.asset=' "$registry" 2>/dev/null | cut -d'=' -f1)
    return 0
}

# 声明片段按当前安装态收敛：组件可执行且有在位模型才落片，否则清退。
# 片段是机制面唯一契约（NAME/BIN/EP/ARGS），不含任何 supervisor 私有知识。
airy_local_decl_sync() {
    local frag registry server asset model port
    frag="$(airy_local_managed_file)"
    registry="$(airy_local_registry_file)"
    server="$(airy_config_get "$registry" server)"
    if [[ -z "$server" || ! -x "$server" ]]; then
        rm -f "$frag"
        return 0
    fi
    asset="$(airy_local_model_pick "$(airy_local_model_registry)")"
    if [[ -z "$asset" ]]; then
        rm -f "$frag"
        return 0
    fi
    model="$(airy_local_models_dir)/${asset}"
    port="${AIRY_LOCAL_LLM_PORT:-11435}"
    airy_mkdir "$(dirname "$frag")"
    airy_config_set "$frag" "AIRYRT_MANAGED_NAME" "llama_server"
    airy_config_set "$frag" "AIRYRT_MANAGED_BIN" "$server"
    airy_config_set "$frag" "AIRYRT_MANAGED_EP" "tcp:${port}"
    airy_config_set "$frag" "AIRYRT_MANAGED_ARGS" "-m ${model} --host 127.0.0.1 --port ${port}"
    airy_log_info "Managed declaration: ${frag} (tcp:${port}, model=${asset})"
}

###############################################################################
# pin 清单解析
###############################################################################

# 查一条 pin 记录：输出 "asset|size|sha256"，未命中返回 1
airy_local_pin_lookup() {
    local pin_file="$1" key="$2"
    local f0 f1 f2 f3 f4
    while IFS='|' read -r f0 f1 f2 f3 f4; do
        if [[ "$f0" == "pin" && "$f1" == "$key" ]]; then
            printf '%s|%s|%s\n' "$f2" "$f3" "$f4"
            return 0
        fi
    done < "$pin_file"
    return 1
}

airy_local_pin_version() {
    awk -F'|' '$1 == "version" { print $2; exit }' "$1"
}

# 查一条模型 pin：输出 "asset|size|sha256"，未命中返回 1
airy_local_model_lookup() {
    local pin_file="$1" name="$2"
    local f0 f1 f2 f3 f4
    while IFS='|' read -r f0 f1 f2 f3 f4; do
        if [[ "$f0" == "model" && "$f1" == "$name" ]]; then
            printf '%s|%s|%s\n' "$f2" "$f3" "$f4"
            return 0
        fi
    done < "$pin_file"
    return 1
}

# 输出某资产的镜像 URL 序列（{asset} 占位符替换）
airy_local_pin_mirrors() {
    local pin_file="$1" asset="$2"
    local f0 name tpl
    while IFS='|' read -r f0 name tpl; do
        if [[ "$f0" == "mirror" ]]; then
            printf '%s\n' "${tpl//\{asset\}/$asset}"
        fi
    done < "$pin_file"
}

###############################################################################
# 平台归一与变体回退链
# 三步链：os-arch-variant → os-arch-cpu（变体非 cpu 时）→ os-arch
# 覆盖全部 pin 键形态（含 macos/win 的裸键与 linux 的 -cpu 键）
###############################################################################

airy_local_resolve_key() {
    local pin_file="$1" variant="$2"
    local plat arch key

    case "$(airy_platform_detect)" in
        linux|wsl) plat="linux" ;;
        macos)     plat="macos" ;;
        windows)   plat="win" ;;
        *)
            airy_log_error "Unsupported platform: $(airy_platform_detect)"
            return 1
            ;;
    esac

    case "$(airy_arch_detect)" in
        x86_64)        arch="x64" ;;
        arm64|aarch64) arch="arm64" ;;
        *)
            airy_log_error "Unsupported arch: $(airy_arch_detect)"
            return 1
            ;;
    esac

    for key in "${plat}-${arch}-${variant}" "${plat}-${arch}-cpu" "${plat}-${arch}"; do
        if airy_local_pin_lookup "$pin_file" "$key" &> /dev/null; then
            echo "$key"
            return 0
        fi
    done

    airy_log_error "No pin for ${plat}-${arch} (variant: ${variant})"
    return 1
}

###############################################################################
# install：下载校验先行（失败保旧安装），落位与注册表后置
###############################################################################

airy_local_cmd_install() {
    local pin_file
    pin_file="$(airy_local_pin_file)"
    if [[ ! -f "$pin_file" ]]; then
        airy_log_fatal "Pin list not found: $pin_file"
    fi

    local key
    key="$(airy_local_resolve_key "$pin_file" "${_AIRY_LOCAL_VARIANT:-sycl}")"

    local record asset size sha
    record="$(airy_local_pin_lookup "$pin_file" "$key")"
    IFS='|' read -r asset size sha <<< "$record"

    local version
    version="$(airy_local_pin_version "$pin_file")"

    local comp_dir registry tmp_dir models_dir bin_dir
    comp_dir="$(airy_local_component_dir)"
    registry="$(airy_local_registry_file)"
    tmp_dir="$(airy_local_home)/local/tmp"
    models_dir="$(airy_local_home)/local/models"
    bin_dir="${comp_dir}/bin"
    airy_mkdir "$tmp_dir"
    airy_mkdir "$models_dir"

    local server="${bin_dir}/llama-server"
    # 幂等：注册表与 pin 记录全一致（key+size+sha256）且 server 可执行即早退；
    # pin 任一字段漂移即重新对账（声明式收敛），失败时保旧安装
    if [[ -x "$server" ]] \
       && [[ "$(airy_config_get "$registry" sha256)" == "$sha" ]] \
       && [[ "$(airy_config_get "$registry" key)" == "$key" ]] \
       && [[ "$(airy_config_get "$registry" size)" == "$size" ]]; then
        airy_log_info "Already installed: ${AIRY_LOCAL_COMPONENT} ${version} (${key})"
        return 0
    fi

    # 来源序列：离线 bundle 优先，镜像序列兜底（GitHub 直连不入序列）
    local -a sources=()
    local bundle_dir="${AIRY_LOCAL_BUNDLE:-}"
    if [[ -n "$bundle_dir" && -f "${bundle_dir}/${asset}" ]]; then
        sources+=("${bundle_dir}/${asset}")
    fi
    local url
    while IFS= read -r url; do
        sources+=("$url")
    done < <(airy_local_pin_mirrors "$pin_file" "$asset")

    if [[ ${#sources[@]} -eq 0 ]]; then
        airy_log_fatal "No source available for asset: $asset"
    fi

    local dest="${tmp_dir}/${asset}"
    local rc=0
    fetch_file_verified "$dest" "$size" "$sha" "${sources[@]}" || rc=$?
    if [[ $rc -eq 2 ]]; then
        airy_log_fatal "Refusing install: poisoned artifact for ${asset}"
    elif [[ $rc -ne 0 ]]; then
        airy_log_fatal "Install aborted: no verified source for ${asset}"
    fi

    local stage="${tmp_dir}/stage.$$"
    rm -rf "$stage"
    airy_mkdir "$stage"

    local unpack_ok=0
    case "$asset" in
        *.tar.gz|*.tgz)
            if tar -xzf "$dest" -C "$stage"; then unpack_ok=1; fi
            ;;
        *.zip)
            if unzip -oq "$dest" -d "$stage"; then unpack_ok=1; fi
            ;;
    esac
    if [[ $unpack_ok -ne 1 ]]; then
        rm -rf "$stage" "$dest"
        airy_log_fatal "Unpack failed or unsupported format: $asset"
    fi

    local -a all_files=()
    local f
    # -type f -o -type l：动态库版本链是 symlink（libggml.so→…so.0→真身），
    # 丢链即 DT_NEEDED 断链；单目录落位下相对 symlink 目标同在 bin/，全链有效
    while IFS= read -r f; do
        all_files+=("$f")
    done < <(find "$stage" \( -type f -o -type l \))

    if [[ ${#all_files[@]} -eq 0 ]]; then
        rm -rf "$stage" "$dest"
        airy_log_fatal "Empty archive: $asset"
    fi

    # 校验全通过后才 wipe 旧安装并落位。单目录 bin/：发行包为平铺布局，
    # 可执行文件与动态库自解析（linux $ORIGIN / mac @loader_path /
    # win 同目录搜索）不容拆分——bin/lib 分离会使二进制失联其依赖。
    rm -rf "$comp_dir"
    airy_mkdir "$bin_dir"

    local name placed_server=""
    for f in "${all_files[@]}"; do
        name="$(basename "$f")"
        case "$name" in
            llama-server*)
                mv -f "$f" "${bin_dir}/${name}"
                placed_server="${bin_dir}/${name}"
                ;;
            *.so|*.so.*|*.dylib|*.dll|*.a)
                mv -f "$f" "${bin_dir}/${name}"
                ;;
            *)
                if [[ -x "$f" ]]; then
                    mv -f "$f" "${bin_dir}/${name}"
                fi
                ;;
        esac
    done
    rm -rf "$stage"

    if [[ -z "$placed_server" ]]; then
        rm -rf "$comp_dir" "$dest"
        airy_log_fatal "llama-server not found in archive: $asset"
    fi

    local bin_f
    for bin_f in "${bin_dir}"/*; do
        if [[ -f "$bin_f" ]]; then
            chmod 0755 "$bin_f"
        fi
    done

    # 冒烟：二进制必须能自报版本
    if ! "$placed_server" --version &> /dev/null; then
        rm -rf "$comp_dir" "$dest"
        airy_log_fatal "Smoke check failed: ${placed_server} --version"
    fi

    airy_config_set "$registry" "component" "$AIRY_LOCAL_COMPONENT"
    airy_config_set "$registry" "version" "$version"
    airy_config_set "$registry" "key" "$key"
    airy_config_set "$registry" "asset" "$asset"
    airy_config_set "$registry" "size" "$size"
    airy_config_set "$registry" "sha256" "$sha"
    airy_config_set "$registry" "server" "$placed_server"
    airy_config_set "$registry" "installed_at" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    rm -f "$dest"
    airy_log_info "Installed: ${AIRY_LOCAL_COMPONENT} ${version} (${key}) -> ${comp_dir}"
    airy_local_decl_sync
}

###############################################################################
# status：注册表 + 实际二进制状态
###############################################################################

airy_local_cmd_status() {
    local registry
    registry="$(airy_local_registry_file)"

    # 组件面与模型面是两个独立维度：组件未装不得挡住模型条目
    echo "component: ${AIRY_LOCAL_COMPONENT}"
    if [[ ! -f "$registry" ]]; then
        echo "status: not installed"
    else
        local version key sha server_path
        version="$(airy_config_get "$registry" version)"
        key="$(airy_config_get "$registry" key)"
        sha="$(airy_config_get "$registry" sha256)"
        server_path="$(airy_config_get "$registry" server)"

        local status="broken"
        if [[ -x "$server_path" ]] && "$server_path" --version &> /dev/null; then
            status="installed"
        fi

        echo "version: ${version}"
        echo "key: ${key}"
        echo "server: ${server_path}"
        echo "sha256: ${sha}"
        echo "status: ${status}"
    fi

    local models_dir models_count=0
    models_dir="$(airy_local_models_dir)"
    if [[ -d "$models_dir" ]]; then
        models_count="$(find "$models_dir" -type f | wc -l | tr -d ' ')"
    fi
    echo "models: ${models_count} file(s) in ${models_dir}"

    # 模型条目（注册过的逐条列出，未注册仅计数）
    local model_registry mkey mname
    model_registry="$(airy_local_model_registry)"
    if [[ -f "$model_registry" ]]; then
        while IFS= read -r mkey; do
            mname="${mkey#model.}"
            mname="${mname%.asset}"
            echo "model: ${mname} ($(airy_config_get "$model_registry" "$mkey"))"
        done < <(grep '^model\..*\.asset=' "$model_registry" | cut -d'=' -f1)
    fi
}

###############################################################################
# remove：净退（组件目录 + 暂存区），models 目录保留给模型层
###############################################################################

airy_local_cmd_remove() {
    local comp_dir tmp_dir
    comp_dir="$(airy_local_component_dir)"
    tmp_dir="$(airy_local_home)/local/tmp"

    if [[ ! -d "$comp_dir" ]]; then
        airy_log_info "Not installed: ${AIRY_LOCAL_COMPONENT}"
        return 0
    fi

    rm -rf "$comp_dir" "$tmp_dir"
    airy_local_decl_sync
    airy_log_info "Removed: ${AIRY_LOCAL_COMPONENT} (models kept: $(airy_local_home)/local/models)"
}

###############################################################################
# model：模型拉取层（gguf 下载/校验/注册，复用 fetch 机制与 mirror 语义）
###############################################################################

airy_local_model_sources() {
    local pin_file="$1" asset="$2"
    local -a sources=()

    local bundle_dir="${AIRY_LOCAL_MODEL_BUNDLE:-}"
    if [[ -n "$bundle_dir" && -f "${bundle_dir}/${asset}" ]]; then
        sources+=("${bundle_dir}/${asset}")
    fi
    local url
    while IFS= read -r url; do
        sources+=("$url")
    done < <(airy_local_pin_mirrors "$pin_file" "$asset")

    if [[ ${#sources[@]} -eq 0 ]]; then
        airy_log_fatal "No source available for model asset: $asset"
    fi
    printf '%s\n' "${sources[@]}"
}

airy_local_cmd_model_install() {
    local name="$1"
    local pin_file
    pin_file="$(airy_local_model_pin_file)"
    if [[ ! -f "$pin_file" ]]; then
        airy_log_fatal "Model pin list not found: $pin_file"
    fi

    local record asset size sha
    if ! record="$(airy_local_model_lookup "$pin_file" "$name")"; then
        airy_log_fatal "Unknown model: $name (not pinned)"
    fi
    IFS='|' read -r asset size sha <<< "$record"

    local models_dir registry tmp_dir target
    models_dir="$(airy_local_models_dir)"
    registry="$(airy_local_model_registry)"
    tmp_dir="$(airy_local_home)/local/tmp"
    target="${models_dir}/${asset}"
    airy_mkdir "$models_dir"
    airy_mkdir "$tmp_dir"

    # 幂等：注册表与 pin 一致（size+sha256）且工件在位即早退；
    # pin 任一字段漂移即重新对账，下载失败保旧工件
    if [[ -f "$target" ]] \
       && [[ "$(airy_config_get "$registry" "model.${name}.sha256")" == "$sha" ]] \
       && [[ "$(airy_config_get "$registry" "model.${name}.size")" == "$size" ]]; then
        airy_log_info "Already installed: model ${name} (${asset})"
        return 0
    fi

    local -a sources=()
    local src
    while IFS= read -r src; do
        sources+=("$src")
    done < <(airy_local_model_sources "$pin_file" "$asset")

    local dest="${tmp_dir}/${asset}"
    local rc=0
    fetch_file_verified "$dest" "$size" "$sha" "${sources[@]}" || rc=$?
    if [[ $rc -eq 2 ]]; then
        airy_log_fatal "Refusing install: poisoned model artifact for ${asset}"
    elif [[ $rc -ne 0 ]]; then
        airy_log_fatal "Install aborted: no verified source for ${asset}"
    fi

    # 校验通过才落位：同盘 mv 原子替换，旧工件保留到新件就位
    mv -f "$dest" "$target"
    airy_config_set "$registry" "model.${name}.asset" "$asset"
    airy_config_set "$registry" "model.${name}.size" "$size"
    airy_config_set "$registry" "model.${name}.sha256" "$sha"
    airy_config_set "$registry" "model.${name}.installed_at" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    airy_log_info "Installed model: ${name} (${asset}) -> ${models_dir}"
    airy_local_decl_sync
}

airy_local_cmd_model_list() {
    local pin_file registry
    pin_file="$(airy_local_model_pin_file)"
    if [[ ! -f "$pin_file" ]]; then
        airy_log_fatal "Model pin list not found: $pin_file"
    fi
    registry="$(airy_local_model_registry)"

    local f0 name asset state
    while IFS='|' read -r f0 name asset; do
        [[ "$f0" == "model" ]] || continue
        if [[ -n "$(airy_config_get "$registry" "model.${name}.sha256")" ]]; then
            state="installed"
        else
            state="pinned"
        fi
        echo "${name} [${state}] ${asset}"
    done < "$pin_file"
}

airy_local_cmd_model_remove() {
    local name="$1"
    local models_dir registry asset
    models_dir="$(airy_local_models_dir)"
    registry="$(airy_local_model_registry)"

    asset="$(airy_config_get "$registry" "model.${name}.asset")"
    if [[ -z "$asset" ]]; then
        airy_log_info "Not installed: model ${name}"
        return 0
    fi

    rm -f "${models_dir}/${asset}"
    airy_config_del "$registry" "model.${name}.asset"
    airy_config_del "$registry" "model.${name}.size"
    airy_config_del "$registry" "model.${name}.sha256"
    airy_config_del "$registry" "model.${name}.installed_at"
    airy_local_decl_sync
    airy_log_info "Removed model: ${name} (${asset})"
}

airy_local_cmd_model() {
    local sub="${1:-}"
    shift || true
    case "$sub" in
        install) airy_local_cmd_model_install "${1:?model install requires a name}" ;;
        remove)  airy_local_cmd_model_remove "${1:?model remove requires a name}" ;;
        list)    airy_local_cmd_model_list ;;
        *)
            airy_log_error "Unknown model subcommand: ${sub:-<empty>}"
            echo "usage: airy-local model install|remove <name>" >&2
            echo "       airy-local model list" >&2
            return 1
            ;;
    esac
}

###############################################################################
# 入口
###############################################################################

airy_local_usage() {
    cat << 'EOF'
airy-local - AgentRT self-hosted component manager

Usage:
  airy-local install  [--variant cpu|sycl] [--pin <file>]
  airy-local status
  airy-local remove
  airy-local model install|remove <name>
  airy-local model list

Options:
  --variant <name>  backend variant (default: sycl, cpu as fallback)
  --pin <file>      pin list override
  -h, --help        show this help

Environment:
  AIRY_HOME              install root (default: ~/.airymaxrt)
  AIRY_LOCAL_BUNDLE      offline asset directory (takes precedence over mirrors)
  AIRY_LOCAL_PIN         pin list path
  AIRY_LOCAL_MODEL_BUNDLE offline model directory (takes precedence over mirrors)
  AIRY_LOCAL_MODEL_PIN   model pin list path
EOF
}

airy_local_main() {
    _AIRY_LOCAL_VARIANT="${AIRY_LOCAL_VARIANT:-sycl}"

    local cmd=""
    while [[ ${#} -gt 0 ]]; do
        case "$1" in
            install|status|remove)
                cmd="$1"
                shift
                ;;
            model)
                airy_local_cmd_model "${@:2}"
                return $?
                ;;
            --variant)
                _AIRY_LOCAL_VARIANT="${2:?--variant requires a value}"
                shift 2
                ;;
            --pin)
                _AIRY_LOCAL_PIN_OVERRIDE="${2:?--pin requires a value}"
                shift 2
                ;;
            -h|--help)
                airy_local_usage
                return 0
                ;;
            *)
                airy_log_error "Unknown argument: $1"
                airy_local_usage >&2
                return 1
                ;;
        esac
    done

    case "$cmd" in
        install) airy_local_cmd_install ;;
        status)  airy_local_cmd_status ;;
        remove)  airy_local_cmd_remove ;;
        *)
            airy_local_usage >&2
            return 1
            ;;
    esac
}

export -f airy_local_home airy_local_component_dir airy_local_registry_file
export -f airy_local_pin_file airy_local_pin_lookup airy_local_pin_version
export -f airy_local_pin_mirrors airy_local_resolve_key
export -f airy_local_models_dir airy_local_model_registry airy_local_model_pin_file
export -f airy_local_model_lookup airy_local_model_sources
export -f airy_local_cmd_model_install airy_local_cmd_model_list
export -f airy_local_cmd_model_remove airy_local_cmd_model

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    airy_local_main "$@"
fi
