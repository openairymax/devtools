# =============================================================================
# AgentRT LLM 凭据模板 — 复制为 ~/.airymaxrt/config/secrets.env 并填写
#
# 这是设置 LLM API Key 的【唯一位置】（agentrt-bootstrap.sh 会自动加载）。
# 权限要求：chmod 600 ~/.airymaxrt/config/secrets.env
# 该文件不进入 git（.gitignore），请勿把 key 写进任何仓库文件。
#
# 变量名与 ecosystem/manager/model/model.yaml 的 providers[].api_key_env
# 一一对应（SSoT）。未使用的 provider 留空即可。
# =============================================================================

# ── DeepSeek（默认提供商）──────────────────────────────────────────────
# 平台：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ── OpenAI（含所有 OpenAI 兼容端点）────────────────────────────────────
OPENAI_API_KEY=

# ── Anthropic ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Google AI ───────────────────────────────────────────────────────────
GOOGLE_AI_API_KEY=

# ── 智谱 GLM（https://open.bigmodel.cn）─────────────────────────────────
GLM_API_KEY=

# ── 通义千问 Qwen（https://dashscope.aliyuncs.com）──────────────────────
DASHSCOPE_API_KEY=

# ── Moonshot Kimi（https://platform.moonshot.cn）────────────────────────
MOONSHOT_API_KEY=

# ── 硅基流动（https://cloud.siliconflow.cn）─────────────────────────────
SILICONFLOW_API_KEY=

# ── 讯飞星火（https://xinghuo.xfyun.cn）─────────────────────────────────
SPARK_API_KEY=

# ── 自定义 OpenAI 兼容厂商（model.yaml providers.custom）──
CUSTOM_LLM_API_KEY=

# ── 可选：agent 子进程（openlab）模型名覆盖 ─────────────────────────────
# 未设置时按 model.yaml 的默认模型路由
# AIRY_AGENT_MODEL=

# ── 可选：LLM 厂商选择（openlab 客户端）────────────────────────────────
# 取值：deepseek / glm / qwen / moonshot / siliconflow / spark / minimax /
#       openai / ollama / 自定义名。未设置时自动探测（deepseek 优先）
# AIRY_LLM_PROVIDER=

# ── 可选：OpenAI 兼容 base_url 覆盖 ─────────────────────────────────────
# 未设置时用所选厂商默认端点（openlab 客户端）；可指向任一 OpenAI 兼容
# 端点（本地 vLLM / 内网代理 / 自定义厂商）
# AIRY_LLM_BASE_URL=
