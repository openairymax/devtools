# =============================================================================
# AgentRT LLM 凭据模板（v2 表格形式）
#
# 复制为 ~/.airymaxrt/config/secrets.env 并填写。
# 这是设置 LLM API Key 的【唯一位置】（agentrt-bootstrap.sh 会自动加载）。
# 权限要求：chmod 600 ~/.airymaxrt/config/secrets.env
# 该文件不进入 git（.gitignore），请勿把 key 写进任何仓库文件。
#
# ★ 最多 3 个模型连接（与 model.yaml 顶部 models 表一一对应）：
#     MODEL_1_API_KEY → models 表第 1 行
#     MODEL_2_API_KEY → models 表第 2 行
#     MODEL_3_API_KEY → models 表第 3 行
#   未使用的模型留空即可；本地模型（mode: local）无需 key。
#   使用哪个厂商、什么地址、什么模型，全部在 model.yaml 的表格里填，
#   这里只放原始 key，统一抽象，不区分厂商。
# =============================================================================

# ── 模型 1（默认模型，对应 model.yaml models[0]）────────────────────────
MODEL_1_API_KEY=

# ── 模型 2（对应 model.yaml models[1]）──────────────────────────────────
MODEL_2_API_KEY=

# ── 模型 3（对应 model.yaml models[2]）──────────────────────────────────
MODEL_3_API_KEY=

# ── 可选：agent 子进程（openlab）模型名覆盖 ─────────────────────────────
# 未设置时按 model.yaml 的默认模型路由
# AIRY_AGENT_MODEL=

# ── 可选：LLM 厂商选择（openlab 客户端）────────────────────────────────
# 未设置时自动探测（模型表中首个有 key 者优先）
# AIRY_LLM_PROVIDER=

# ── 可选：OpenAI 兼容 base_url 覆盖 ─────────────────────────────────────
# 未设置时用 model.yaml 表格里配置的端点；可临时指向任一 OpenAI 兼容
# 端点（本地 vLLM / 内网代理 / 自定义厂商）
# AIRY_LLM_BASE_URL=
